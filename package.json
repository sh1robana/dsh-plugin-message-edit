    },
    {
      "name": "Codex（OpenAI AI 编程助手）",
      "url": "https://openai.com/codex/"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sh1robana/dsh-plugin-message-edit.git"
  },
  "homepage": "https://github.com/sh1robana/dsh-plugin-message-edit#readme",
